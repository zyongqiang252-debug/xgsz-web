.milestone-feature {
  overflow: hidden;
  border: 1rpx solid #e1eaec;
  border-radius: 12rpx;
  background: #ffffff;
}

.milestone-image {
  width: 100%;
  height: 300rpx;
}

.milestone-feature-body {
  padding: 26rpx;
}

.milestone-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.milestone-tag {
  padding: 5rpx 12rpx;
  border-radius: 4rpx;
  background: #e8f7f4;
  color: #008f88;
  font-size: 19rpx;
}

.milestone-tag.light {
  background: #f1f6f6;
  color: #668088;
}

.milestone-date {
  color: #91a2a8;
  font-size: 20rpx;
}

.milestone-title {
  display: block;
  margin-top: 14rpx;
  color: #17323d;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
}

.milestone-desc {
  display: block;
  margin-top: 10rpx;
  color: #6f828a;
  font-size: 23rpx;
  line-height: 1.85;
}

.milestone-list {
  margin-top: 20rpx;
}

.milestone-row {
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #e4ecee;
  border-radius: 10rpx;
  background: #ffffff;
}

.milestone-row-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.milestone-row-title {
  display: block;
  margin-top: 10rpx;
  color: #294752;
  font-size: 26rpx;
  font-weight: 600;
}

.milestone-row-desc {
  display: block;
  margin-top: 6rpx;
  color: #7d8f95;
  font-size: 22rpx;
  line-height: 1.75;
}

.about-title {
  display: block;
  margin-top: 14rpx;
  color: #102731;
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.45;
}

.about-sign {
  display: block;
  margin-top: 12rpx;
  color: #008f88;
  font-size: 24rpx;
  line-height: 1.7;
}

.about-lead {
  display: block;
  margin-top: 24rpx;
  padding-left: 20rpx;
  border-left: 5rpx solid #00b9af;
  color: #34535e;
  font-size: 25rpx;
  line-height: 1.9;
}

.about-body {
  margin-top: 18rpx;
}

.about-paragraph {
  display: block;
  margin-top: 12rpx;
  color: #657b83;
  font-size: 23rpx;
  line-height: 1.95;
}

.business-grid {
  display: flex;
  flex-wrap: wrap;
}

.business-card {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 26rpx;
  border: 1rpx solid #e1eaec;
  border-radius: 10rpx;
  background: #f8fbfb;
}

.business-index {
  display: block;
  color: #00a89f;
  font-size: 19rpx;
}

.business-name {
  display: block;
  margin-top: 8rpx;
  color: #17323d;
  font-size: 29rpx;
  font-weight: 600;
}

.business-desc {
  display: block;
  margin-top: 8rpx;
  color: #74858c;
  font-size: 22rpx;
  line-height: 1.8;
}

.business-more {
  display: block;
  margin-top: 14rpx;
  color: #008f88;
  font-size: 21rpx;
  font-weight: 600;
}

.support-list {
  margin-top: 24rpx;
}

.support-row {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e0e9ea;
}

.support-index {
  width: 54rpx;
  color: #00a89f;
  font-size: 20rpx;
}

.support-copy {
  flex: 1;
  min-width: 0;
}

.support-label {
  display: block;
  color: #91a2a8;
  font-size: 19rpx;
  letter-spacing: 1rpx;
}

.support-title {
  display: block;
  margin-top: 6rpx;
  color: #24434f;
  font-size: 27rpx;
  font-weight: 600;
}

.support-desc {
  display: block;
  margin-top: 8rpx;
  color: #71858c;
  font-size: 22rpx;
  line-height: 1.8;
}

.principles {
  padding: 56rpx 0;
  background: #092330;
}

.principles-kicker {
  display: block;
  color: #54ded4;
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.principles-title {
  display: block;
  margin-top: 12rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.45;
}

.principles-desc {
  display: block;
  margin-top: 12rpx;
  color: #8aa8af;
  font-size: 23rpx;
  line-height: 1.8;
}

.principle-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.principle-card {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.03);
}

.principle-title {
  display: block;
  color: #e9f5f4;
  font-size: 26rpx;
  font-weight: 600;
}

.principle-desc {
  display: block;
  margin-top: 7rpx;
  color: #8aa8af;
  font-size: 21rpx;
  line-height: 1.8;
}

.about-image {
  width: 100%;
  margin-bottom: 18rpx;
  border-radius: 10rpx;
}
