.contact-kicker {
  display: block;
  color: #008f88;
  font-size: 21rpx;
  letter-spacing: 2rpx;
}

.contact-title {
  display: block;
  margin-top: 14rpx;
  color: #102731;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.45;
}

.contact-desc {
  display: block;
  margin-top: 18rpx;
  color: #647b83;
  font-size: 24rpx;
  line-height: 1.9;
}

.contact-note {
  display: block;
  margin-top: 12rpx;
  color: #8a9ba1;
  font-size: 22rpx;
  line-height: 1.8;
}

.contact-primary {
  margin-top: 26rpx;
}

.contact-card {
  padding: 30rpx;
  border: 1rpx solid #e1eaec;
  border-radius: 12rpx;
  background: #ffffff;
}

.contact-head {
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e8eff0;
}

.contact-head-title {
  display: block;
  color: #17323d;
  font-size: 32rpx;
  font-weight: 600;
}

.contact-head-desc {
  display: block;
  margin-top: 8rpx;
  color: #8a9ba1;
  font-size: 21rpx;
}

.contact-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2f3;
}

.contact-row:last-child {
  border-bottom: 0;
}

.contact-row-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #e9f8f6;
  color: #008f88;
  font-size: 22rpx;
}

.contact-row-copy {
  flex: 1;
  min-width: 0;
}

.contact-row-label {
  display: block;
  color: #91a2a8;
  font-size: 19rpx;
}

.contact-row-value {
  display: block;
  margin-top: 5rpx;
  color: #294752;
  font-size: 26rpx;
  font-weight: 600;
  word-break: break-all;
}

.contact-row-hint {
  display: block;
  margin-top: 5rpx;
  color: #8a9ba1;
  font-size: 21rpx;
}

.contact-row-action {
  flex-shrink: 0;
  margin-left: 14rpx;
  color: #008f88;
  font-size: 21rpx;
}

.wecom-qr {
  width: 240rpx;
  height: 240rpx;
  margin: 20rpx auto;
}

.contact-tip {
  margin-top: 22rpx;
  padding: 28rpx;
  border-radius: 12rpx;
  background: #092330;
}

.contact-tip-title {
  display: block;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.contact-tip-desc {
  display: block;
  margin-top: 8rpx;
  color: #91adb4;
  font-size: 22rpx;
  line-height: 1.8;
}

.contact-tip .btn {
  margin-top: 20rpx;
}
