[Unit]
Description=XGSZ official website and administration
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xgsz
Group=xgsz
WorkingDirectory=/opt/xgsz-website
EnvironmentFile=/opt/xgsz-website/app.env
ExecStart=/usr/bin/java -Dfile.encoding=UTF-8 -Xms64m -Xmx256m -XX:MaxMetaspaceSize=160m -XX:ReservedCodeCacheSize=64m -XX:+UseSerialGC -jar /opt/xgsz-website/app.jar
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=450M
MemoryMax=600M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077

[Install]
WantedBy=multi-user.target
